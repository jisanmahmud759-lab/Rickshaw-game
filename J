// 🎵 অডিও ইঞ্জিন (Web Audio API)
// ============================================
const AudioEngine = {
  ctx: null,
  masterGain: null,
  engineOsc: null,
  engineGain: null,
  engineLfo: null,
  enabled: false,

  init() {
    if (this.ctx) return;
    const AC = window.AudioContext || window.webkitAudioContext;
    this.ctx = new AC();
    this.masterGain = this.ctx.createGain();
    this.masterGain.gain.value = 0.4;
    this.masterGain.connect(this.ctx.destination);
  },

  resume() {
    if (this.ctx && this.ctx.state === 'suspended') {
      this.ctx.resume();
    }
  },

  // 🔧 রিকশার ইঞ্জিন শব্দ (সতত চলমান)
  startEngine() {
    if (!this.ctx) return;
    this.stopEngine();

    this.engineOsc = this.ctx.createOscillator();
    this.engineOsc.type = 'sawtooth';
    this.engineOsc.frequency.value = 60;

    // LFO দিয়ে ঘর্ঘর শব্দ
    this.engineLfo = this.ctx.createOscillator();
    this.engineLfo.type = 'sine';
    this.engineLfo.frequency.value = 8;
    const lfoGain = this.ctx.createGain();
    lfoGain.gain.value = 6;
    this.engineLfo.connect(lfoGain);
    lfoGain.connect(this.engineOsc.frequency);

    this.engineGain = this.ctx.createGain();
    this.engineGain.gain.value = 0.06;

    // ফিল্টার (মোটা শব্দ)
    const filter = this.ctx.createBiquadFilter();
    filter.type = 'lowpass';
    filter.frequency.value = 400;

    this.engineOsc.connect(filter);
    filter.connect(this.engineGain);
    this.engineGain.connect(this.masterGain);

    this.engineOsc.start();
    this.engineLfo.start();
    this.enabled = true;
  },

  stopEngine() {
    if (this.engineOsc) {
      try { this.engineOsc.stop(); } catch(e) {}
      this.engineOsc = null;
    }
    if (this.engineLfo) {
      try { this.engineLfo.stop(); } catch(e) {}
      this.engineLfo = null;
    }
    this.enabled = false;
  },

  // গতি অনুযায়ী ইঞ্জিন পিচ
  updateEngine(speed) {
    if (!this.engineOsc || !this.engineGain) return;
    const freq = 50 + speed * 6;
    this.engineOsc.frequency.setTargetAtTime(freq, this.ctx.currentTime, 0.1);
    const vol = 0.04 + speed * 0.012;
    this.engineGain.gain.setTargetAtTime(vol, this.ctx.currentTime, 0.1);
  },

  // 💥 ধাক্কার শব্দ
  playCrash() {
    if (!this.ctx) return;
    const t = this.ctx.currentTime;

    // নয়েজ বার্স্ট
    const bufferSize = this.ctx.sampleRate * 0.3;
    const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
    const data = buffer.getChannelData(0);
    for (let i = 0; i < bufferSize; i++) {
      data[i] = (Math.random() * 2 - 1) * (1 - i / bufferSize);
    }
    const noise = this.ctx.createBufferSource();
    noise.buffer = buffer;

    const noiseGain = this.ctx.createGain();
    noiseGain.gain.setValueAtTime(0.5, t);
    noiseGain.gain.exponentialRampToValueAtTime(0.01, t + 0.3);

    const lp = this.ctx.createBiquadFilter();
    lp.type = 'lowpass';
    lp.frequency.value = 1200;

    noise.connect(lp);
    lp.connect(noiseGain);
    noiseGain.connect(this.masterGain);
    noise.start(t);
    noise.stop(t + 0.3);

    // নিচু থাম্প
    const osc = this.ctx.createOscillator();
    osc.type = 'square';
    osc.frequency.setValueAtTime(120, t);
    osc.frequency.exponentialRampToValueAtTime(40, t + 0.25);
    const og = this.ctx.createGain();
    og.gain.setValueAtTime(0.4, t);
    og.gain.exponentialRampToValueAtTime(0.01, t + 0.3);
    osc.connect(og);
    og.connect(this.masterGain);
    osc.start(t);
    osc.stop(t + 0.3);
  },

  // 🎯 স্কোর সাউন্ড (ব্লিপ)
  playScore() {
    if (!this.ctx) return;
    const t = this.ctx.currentTime;
    const osc = this.ctx.createOscillator();
    osc.type = 'sine';
    osc.frequency.setValueAtTime(800, t);
    osc.frequency.exponentialRampToValueAtTime(1400, t + 0.08);
    const g = this.ctx.createGain();
    g.gain.setValueAtTime(0.15, t);
    g.gain.exponentialRampToValueAtTime(0.01, t + 0.1);
    osc.connect(g);
    g.connect(this.masterGain);
    osc.start(t);
    osc.stop(t + 0.1);
  },

  // 🖱️ বাটন ক্লিক
  playClick() {
    if (!this.ctx) return;
    const t = this.ctx.currentTime;
    const osc = this.ctx.createOscillator();
    osc.type = 'triangle';
    osc.frequency.value = 600;
    const g = this.ctx.createGain();
    g.gain.setValueAtTime(0.2, t);
    g.gain.exponentialRampToValueAtTime(0.01, t + 0.06);
    osc.connect(g);
    g.connect(this.masterGain);
    osc.start(t);
    osc.stop(t + 0.06);
  },

  // 💀 গেম ওভার
  playGameOver() {
    if (!this.ctx) return;
    const t = this.ctx.currentTime;
    const notes = [400, 350, 300, 200];
    notes.forEach((f, i) => {
      const osc = this.ctx.createOscillator();
      osc.type = 'square';
      osc.frequency.value = f;
      const g = this.ctx.createGain();
      const start = t + i * 0.18;
      g.gain.setValueAtTime(0.001, start);
      g.gain.linearRampToValueAtTime(0.2, start + 0.02);
      g.gain.exponentialRampToValueAtTime(0.01, start + 0.16);
      osc.connect(g);
      g.connect(this.masterGain);
      osc.start(start);
      osc.stop(start + 0.18);
    });
  },

  // 🎉 নতুন লাইফ/পাওয়ারআপ
  playBonus() {
    if (!this.ctx) return;
    const t = this.ctx.currentTime;
    const notes = [523, 659, 784, 1046];
    notes.forEach((f, i) => {
      const osc = this.ctx.createOscillator();
      osc.type = 'sine';
      osc.frequency.value = f;
      const g = this.ctx.createGain();
      const start = t + i * 0.06;
      g.gain.setValueAtTime(0.18, start);
      g.gain.exponentialRampToValueAtTime(0.01, start + 0.15);
      osc.connect(g);
      g.connect(this.masterGain);
      osc.start(start);
      osc.stop(start + 0.15);
    });
  },
};

