const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');

function resize() {
  const container = document.getElementById('game-container');
  canvas.width = container.clientWidth;
  canvas.height = container.clientHeight;
}
window.addEventListener('resize', resize);
resize();

const game = {
  running: false,
  score: 0,
  lives: 3,
  distance: 0,
  speed: CONFIG.baseSpeed,
  lastSpawn: 0,
  lastMeme: 0,
  roadOffset: 0,
  obstacles: [],
  particles: [],
  keys: {},
  touchDir: null,
  lastEngineUpdate: 0,
};

const player = {
  x: 0,
  y: 0,
  w: 46,
  h: 80,
};

function getLaneX(laneIndex) {
  const roadCenter = canvas.width / 2;
  const startX = roadCenter - (CONFIG.roadWidth / 2) + (CONFIG.laneWidth / 2);
  return startX + laneIndex * CONFIG.laneWidth;
}

// ইনপুট
document.addEventListener('keydown', (e) => {
  game.keys[e.key] = true;
  if (['ArrowLeft','ArrowRight','ArrowUp','ArrowDown',' '].includes(e.key)) {
    e.preventDefault();
  }
});
document.addEventListener('keyup', (e) => { game.keys[e.key] = false; });

function bindMobileBtn(id, dir) {
  const btn = document.getElementById(id);
  const start = (e) => { e.preventDefault(); game.touchDir = dir; };
  const end = (e) => { e.preventDefault(); if (game.touchDir === dir) game.touchDir = null; };
  btn.addEventListener('touchstart', start);
  btn.addEventListener('touchend', end);
  btn.addEventListener('mousedown', start);
  btn.addEventListener('mouseup', end);
}
bindMobileBtn('btnLeft', 'left');
bindMobileBtn('btnRight', 'right');
bindMobileBtn('btnUp', 'up');
bindMobileBtn('btnDown', 'down');

const VEHICLE_TYPES = [
  { emoji: '🚌', color: '#2e7d32', name: 'bus', w: 60, h: 120, points: 15 },
  { emoji: '🚗', color: '#c62828', name: 'car', w: 46, h: 80, points: 10 },
  { emoji: '🏍️', color: '#f9a825', name: 'bike', w: 30, h: 55, points: 5 },
  { emoji: '🛺', color: '#6a1b9a', name: 'rickshaw', w: 44, h: 78, points: 8 },
];

function spawnObstacle() {
  const type = VEHICLE_TYPES[Math.floor(Math.random() * VEHICLE_TYPES.length)];
  const lane = Math.floor(Math.random() * 4);
  game.obstacles.push({
    ...type,
    x: getLaneX(lane),
    y: -150,
    passed: false,
  });
}

function showMeme(text, speak = false) {
  const popup = document.getElementById('memePopup');
  popup.textContent = text;
  popup.classList.add('show');
  clearTimeout(popup._timer);
  popup._timer = setTimeout(() => popup.classList.remove('show'), 1200);

  if (speak) {
    MemeVoice.speak(text);
  }
}

function addParticles(x, y, color, count = 12) {
  for (let i = 0; i < count; i++) {
    game.particles.push({
      x, y,
      vx: (Math.random() - 0.5) * 8,
      vy: (Math.random() - 0.5) * 8 - 2,
      life: 1,
      color,
      size: Math.random() * 5 + 2,
    });
  }
}

function update(dt) {
  if (!game.running) return;

  game.speed = Math.min(CONFIG.maxSpeed, CONFIG.baseSpeed + game.distance / 500);
  document.getElementById('speed').textContent = Math.floor(game.speed * 10);

  game.distance += game.speed * dt * 0.05;
  game.score += Math.floor(game.speed * dt * 0.3);
  document.getElementById('distance').textContent = Math.floor(game.distance);
  document.getElementById('score').textContent = game.score;

  game.roadOffset = (game.roadOffset + game.speed * 3) % 60;

  // ইঞ্জিন সাউন্ড আপডেট (প্রতি ১০০ms)
  const now = performance.now();
  if (now - game.lastEngineUpdate > 100) {
    AudioEngine.updateEngine(game.speed);
    game.lastEngineUpdate = now;
  }

  let dir = 0;
  if (game.keys['ArrowLeft'] || game.keys['a'] || game.keys['A'] || game.touchDir === 'left') dir = -1;
  if (game.keys['ArrowRight'] || game.keys['d'] || game.keys['D'] || game.touchDir === 'right') dir = 1;

  const moveSpeed = 320;
  const roadLeft = canvas.width / 2 - CONFIG.roadWidth / 2 + player.w / 2 + 5;
  const roadRight = canvas.width / 2 + CONFIG.roadWidth / 2 - player.w / 2 - 5;
  player.x = Math.max(roadLeft, Math.min(roadRight, player.x + dir * moveSpeed * dt));

  if (game.keys['ArrowUp'] || game.keys['w'] || game.keys['W'] || game.touchDir === 'up') {
    game.speed = Math.min(CONFIG.maxSpeed, game.speed + 0.1);
  }
  if (game.keys['ArrowDown'] || game.keys['s'] || game.keys['S'] || game.touchDir === 'down') {
    game.speed = Math.max(CONFIG.baseSpeed * 0.5, game.speed - 0.1);
  }

  if (now - game.lastSpawn > CONFIG.spawnInterval) {
    spawnObstacle();
    game.lastSpawn = now;
  }

  for (let i = game.obstacles.length - 1; i >= 0; i--) {
    const obs = game.obstacles[i];
    obs.y += (game.speed * 3 + obs.h * 0.3) * dt * 8;

    if (!obs.passed && obs.y > player.y + player.h) {
      obs.passed = true;
      game.score += obs.points;
      AudioEngine.playScore();
    }

    if (
      Math.abs(obs.x - player.x) < (obs.w + player.w) / 2 - 8 &&
      Math.abs(obs.y - player.y) < (obs.h + player.h) / 2 - 12
    ) {
      game.lives--;
      document.getElementById('lives').textContent = game.lives;
      addParticles(player.x, player.y, '#ff0000', 20);
      AudioEngine.playCrash();
      const meme = MEMES[Math.floor(Math.random() * MEMES.length)];
      showMeme(meme, true); // 🎤 বাংলা ভয়েসে বলবে
      game.obstacles.splice(i, 1);
      if (game.lives <= 0) gameOver();
      continue;
    }

    if (obs.y > canvas.height + 150) {
      game.obstacles.splice(i, 1);
    }
  }

  for (let i = game.particles.length - 1; i >= 0; i--) {
    const p = game.particles[i];
    p.x += p.vx;
    p.y += p.vy;
    p.vy += 0.3;
    p.life -= dt * 2;
    if (p.life <= 0) game.particles.splice(i, 1);
  }

  if (now - game.lastMeme > CONFIG.memeCooldown && Math.random() < 0.02) {
    const meme = MEMES[Math.floor(Math.random() * MEMES.length)];
    showMeme(meme, Math.random() < 0.5); // ৫০% ভয়েস
    game.lastMeme = now;
  }
}

function draw() {
  const W = canvas.width;
  const H = canvas.height;
  const roadLeft = W / 2 - CONFIG.roadWidth / 2;
  const roadRight = W / 2 + CONFIG.roadWidth / 2;

  ctx.fillStyle = '#4a7c3f';
  ctx.fillRect(0, 0, W, H);
  ctx.fillStyle = '#3a3a3a';
  ctx.fillRect(roadLeft, 0, CONFIG.roadWidth, H);

  ctx.fillStyle = '#fff';
  ctx.fillRect(roadLeft, 0, 4, H);
  ctx.fillRect(roadRight - 4, 0, 4, H);

  ctx.fillStyle = '#ffd700';
  for (let lane = 1; lane < 4; lane++) {
    const x = roadLeft + lane * CONFIG.laneWidth;
    for (let y = -60 + game.roadOffset; y < H; y += 60) {
      ctx.fillRect(x - 2, y, 4, 30);
    }
  }

  player.y = H - 130;
  drawRickshaw(player.x, player.y);

  for (const obs of game.obstacles) drawVehicle(obs);

  for (const p of game.particles) {
    ctx.globalAlpha = p.life;
    ctx.fillStyle = p.color;
    ctx.beginPath();
    ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
    ctx.fill();
  }
  ctx.globalAlpha = 1;
}

function drawRickshaw(x, y) {
  const w = player.w, h = player.h;
  ctx.fillStyle = 'rgba(0,0,0,0.3)';
  ctx.beginPath();
  ctx.ellipse(x, y + h / 2 + 5, w / 2, 8, 0, 0, Math.PI * 2);
  ctx.fill();

  ctx.fillStyle = '#111';
  ctx.beginPath(); ctx.arc(x - w/2 + 6, y + h/2 - 8, 10, 0, Math.PI*2); ctx.fill();
  ctx.beginPath(); ctx.arc(x + w/2 - 6, y + h/2 - 8, 10, 0, Math.PI*2); ctx.fill();
  ctx.beginPath(); ctx.arc(x, y - h/2 + 10, 8, 0, Math.PI*2); ctx.fill();

  ctx.fillStyle = '#1b8a3a';
  ctx.fillRect(x - w/2, y - h/2 + 12, w, h - 20);

  ctx.fillStyle = '#ffd700';
  ctx.fillRect(x - w/2 - 3, y - h/2 + 6, w + 6, 12);

  ctx.fillStyle = '#87ceeb';
  ctx.fillRect(x - w/2 + 6, y - h/2 + 22, w - 12, 20);

  ctx.font = '30px serif';
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';
  ctx.fillText('🛺', x, y + 5);
}

function drawVehicle(v) {
  ctx.save();
  ctx.translate(v.x, v.y);
  ctx.fillStyle = 'rgba(0,0,0,0.3)';
  ctx.beginPath();
  ctx.ellipse(0, v.h / 2 + 4, v.w / 2, 6, 0, 0, Math.PI * 2);
  ctx.fill();
  ctx.fillStyle = v.color;
  ctx.fillRect(-v.w / 2, -v.h / 2, v.w, v.h);
  ctx.font = `${Math.min(v.w, v.h) * 0.7}px serif`;
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';
  ctx.fillText(v.emoji, 0, 0);
  ctx.restore();
}

let lastTime = 0;
function loop(time) {
  const dt = Math.min(0.05, (time - lastTime) / 1000);
  lastTime = time;
  update(dt);
  draw();
  requestAnimationFrame(loop);
}
requestAnimationFrame(loop);

function startGame() {
  // 🎵 অডিও চালু (ইউজার ক্লিকের কারণে ব্রাউজার অনুমতি দেবে)
  AudioEngine.init();
  AudioEngine.resume();
  AudioEngine.playClick();
  setTimeout(() => AudioEngine.startEngine(), 100);

  game.running = true;
  game.score = 0;
  game.lives = 3;
  game.distance = 0;
  game.speed = CONFIG.baseSpeed;
  game.obstacles = [];
  game.particles = [];
  game.lastSpawn = performance.now();
  game.lastMeme = performance.now();
  player.x = canvas.width / 2;

  document.getElementById('score').textContent = 0;
  document.getElementById('lives').textContent = 3;
  document.getElementById('distance').textContent = 0;
  document.getElementById('startScreen').classList.add('hidden');
  document.getElementById('gameOverScreen').classList.add('hidden');
  document.getElementById('mobileControls').classList.remove('hidden');

  showMeme('🛺 চলো শুরু করি!', true);
}

function gameOver() {
  game.running = false;
  AudioEngine.stopEngine();
  AudioEngine.playGameOver();
  document.getElementById('finalScore').textContent = game.score;
  document.getElementById('finalDistance').textContent = Math.floor(game.distance);
  document.getElementById('gameOverScreen').classList.remove('hidden');
  document.getElementById('mobileControls').classList.add('hidden');
  setTimeout(() => showMeme('💥 শেষ!', true), 500);
}

document.getElementById('startBtn').addEventListener('click', startGame);
document.getElementById('restartBtn').addEventListener('click', startGame);

if ('ontouchstart' in window) {
  document.getElementById('mobileControls').classList.remove('hidden');
}

